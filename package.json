{
  "name": "iobroker.powerqueue",
  "version": "0.0.1",
  "description": "Distributes an available electrical power budget among prioritized, flexible consumers",
  "author": {
    "name": "typhosj",
    "email": "typhosj@gmx.de"
  },
  "contributors": [],
  "homepage": "https://github.com/typhosj/ioBroker.powerqueue",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "energy",
    "power",
    "surplus",
    "pv",
    "load-management",
    "priority"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/typhosj/ioBroker.powerqueue.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/adapter-react-v5": "^8.3.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^6.5.0",
    "@tsconfig/node22": "^22.0.5",
    "esbuild": "^0.28.1",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "vite": "^8.1.5"
  },
  "main": "build/main.js",
  "files": [
    "admin/**/*.{css,html,js,json,png,svg}",
    "build/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build admin/assets admin/index.html",
    "build": "npm run build:ts && npm run build:admin",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "build:admin": "vite build --config vite.admin.config.mjs",
    "watch:admin": "vite build --watch --config vite.admin.config.mjs",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit && tsc --noEmit -p src-admin/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "release": "release-script",
    "pr:repocheck": "node -e \"for (const p of ['build', 'admin/assets', 'admin/index.html']) require('fs').rmSync(p, { recursive: true, force: true })\" && npx @iobroker/repochecker https://github.com/typhosj/ioBroker.powerqueue --local"
  },
  "bugs": {
    "url": "https://github.com/typhosj/ioBroker.powerqueue/issues"
  },
  "readmeFilename": "README.md"
}