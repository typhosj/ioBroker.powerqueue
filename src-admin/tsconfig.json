{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["vite/client", "iobroker", "mocha", "chai"]
    },
    // The admin UI drives the very same allocator and configuration model the adapter runs, so the
    // shared modules in src/lib are part of this program too.
    "include": ["src/**/*.ts", "src/**/*.tsx", "../src/lib/**/*.ts"],
    "exclude": ["../src/lib/**/*.test.ts"]
}
